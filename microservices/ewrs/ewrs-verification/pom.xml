<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.nklip.javacraft</groupId>
        <artifactId>ewrs</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>dev.nklip.javacraft.ewrs</groupId>
    <artifactId>ewrs-verification</artifactId>
    <packaging>pom</packaging>

    <dependencies>
        <!--
            Compile-scope dependencies contribute their classes, sources, and execution data
            to report-aggregate. Together these modules form the EWRS production system.
        -->
        <dependency>
            <groupId>dev.nklip.javacraft.ewrs</groupId>
            <artifactId>ewrs-events</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.nklip.javacraft.ewrs</groupId>
            <artifactId>ewrs-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.nklip.javacraft.ewrs</groupId>
            <artifactId>ewrs-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.nklip.javacraft.ewrs</groupId>
            <artifactId>ewrs-scenarios</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.nklip.javacraft.ewrs</groupId>
            <artifactId>ewrs-dashboard</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            A test-scope dependency contributes execution data only. ewrs-testing owns no
            production classes, but its tests exercise the production modules above.
        -->
        <dependency>
            <groupId>dev.nklip.javacraft.ewrs</groupId>
            <artifactId>ewrs-testing</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>${maven-install-plugin.version}</version>
                <configuration>
                    <!-- This report-only module is a reactor utility, not a published library. -->
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>${maven-deploy-plugin.version}</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <!--
                        A report-only POM has no tests or classes of its own. Disable the two
                        inherited per-module executions and run only the aggregate at verify.
                    -->
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
