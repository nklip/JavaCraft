<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.nklip.javacraft</groupId>
        <artifactId>shardshop</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>shardshop-order</artifactId>
    <packaging>jar</packaging>

    <properties>
        <shardshop.failIfNoTests>true</shardshop.failIfNoTests>
        <shardshop.directory>${project.basedir}/..</shardshop.directory>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.nklip.javacraft</groupId>
            <artifactId>shardshop-common</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.nklip.javacraft</groupId>
            <artifactId>shardshop-sharding</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>routing-startup-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <includes combine.self="override">
                                <include>**/ShardRoutingStartupIT.java</include>
                            </includes>
                            <failIfNoTests>true</failIfNoTests>
                            <summaryFile>${project.build.directory}/failsafe-reports/routing-startup-summary.xml</summaryFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <configuration>
                    <!-- The deployed routing snapshot is required at runtime, not during augmentation. -->
                    <systemProperties>
                        <quarkus.config.locations>application.properties</quarkus.config.locations>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
