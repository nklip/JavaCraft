<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.nklip.javacraft</groupId>
        <artifactId>shardshop</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>shardshop-order</artifactId>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.proc>none</maven.compiler.proc>
        <shardshop.failIfNoTests>true</shardshop.failIfNoTests>
        <shardshop.idGenerationBoundary.skip>true</shardshop.idGenerationBoundary.skip>
        <shardshop.directory>${project.basedir}/..</shardshop.directory>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Kafka's inherited 1.11.1 has GHSA-343h-94h5-c4wr and four related advisories.
                 Keep this security override local to the CDC runtime; see VERSIONS.md step 4.4. -->
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.12.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>dev.nklip.javacraft</groupId>
            <artifactId>shardshop-common</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.nklip.javacraft</groupId>
            <artifactId>shardshop-idgen</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.nklip.javacraft</groupId>
            <artifactId>shardshop-sharding</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.debezium</groupId>
            <artifactId>debezium-embedded</artifactId>
        </dependency>
        <dependency>
            <groupId>io.debezium</groupId>
            <artifactId>debezium-connector-postgres</artifactId>
        </dependency>
        <dependency>
            <groupId>io.debezium</groupId>
            <artifactId>debezium-storage-jdbc</artifactId>
        </dependency>
        <!-- JDBC storage marks this implementation dependency provided; an embedded host must supply it. -->
        <dependency>
            <groupId>io.debezium</groupId>
            <artifactId>debezium-storage-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rabbitmq</groupId>
            <artifactId>amqp-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The contract test checks the order OpenAPI document and the RecordOrder schema with ContractDocument and Vert.x JSON Schema. -->
        <dependency>
            <groupId>dev.nklip.javacraft</groupId>
            <artifactId>shardshop-common</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-openapi</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>routing-startup-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <includes combine.self="override">
                                <include>**/ShardRoutingStartupIT.java</include>
                            </includes>
                            <failIfNoTests>true</failIfNoTests>
                            <summaryFile>${project.build.directory}/failsafe-reports/routing-startup-summary.xml</summaryFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <configuration>
                    <!-- The deployed routing snapshot is required at runtime, not during augmentation. -->
                    <systemProperties>
                        <quarkus.config.locations>application.properties</quarkus.config.locations>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
