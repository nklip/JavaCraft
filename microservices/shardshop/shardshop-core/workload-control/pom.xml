<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.nklip.javacraft</groupId>
        <artifactId>shardshop-core</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <!--
        Live traffic control of the three workload applications: the shared pacer, the control state, the control
        REST resource and the page script and stylesheet. Only the workloads depend on this library.
    -->
    <artifactId>shardshop-workload-control</artifactId>
    <packaging>jar</packaging>

    <properties>
        <shardshop.failIfNoTests>true</shardshop.failIfNoTests>
        <shardshop.directory>${project.basedir}/../..</shardshop.directory>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The contract test checks the control OpenAPI document with ContractDocument and Vert.x JSON Schema. -->
        <dependency>
            <groupId>dev.nklip.javacraft</groupId>
            <artifactId>shardshop-common</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-openapi</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-json-schema</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
