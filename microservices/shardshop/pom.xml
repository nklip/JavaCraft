<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.nklip.javacraft</groupId>
        <artifactId>microservices</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>shardshop</artifactId>
    <packaging>pom</packaging>

    <properties>
        <java.release>25</java.release>
        <quarkus.version>3.40.1</quarkus.version>
        <argLine/>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <junit6.version>6.1.3</junit6.version>
        <!-- Align inherited families and test agents with the Quarkus platform BOM. -->
        <netty.version>4.1.138.Final</netty.version>
        <mockito.version>5.21.0</mockito.version>
        <lombok.version>1.18.46</lombok.version>
        <test.jvm.args>-Xshare:off -XX:-EnableDynamicAgentLoading</test.jvm.args>
        <mockito.agent.argLine>-javaagent:"${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar"</mockito.agent.argLine>
        <snowflake-id.version>0.0.2</snowflake-id.version>
        <shardshop.directory>${project.basedir}</shardshop.directory>
        <jacoco.it.argLine/>
        <shardshop.failIfNoTests>false</shardshop.failIfNoTests>
        <shardshop.idGenerationBoundary.skip>false</shardshop.idGenerationBoundary.skip>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-help-plugin.version>3.5.2</maven-help-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-toolchains-plugin.version>3.3.0</maven-toolchains-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
        <versions-maven-plugin.version>2.22.0</versions-maven-plugin.version>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
        <sisu.version>1.1.0</sisu.version>
        <tc.image.postgresql>docker.io/library/postgres@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722</tc.image.postgresql>
        <tc.image.rabbitmq>docker.io/library/rabbitmq@sha256:cdf40d8cb363d145e377ed88d59696a42386ffe54b30125f10eb128b862eea95</tc.image.rabbitmq>
    </properties>

    <modules>
        <module>shardshop-core</module>
        <module>shardshop-workload</module>
        <module>shardshop-product</module>
        <module>shardshop-order</module>
        <module>shardshop-ledger</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Named exception; only core/idgen declares this dependency. -->
            <dependency>
                <groupId>de.mkammerer.snowflake-id</groupId>
                <artifactId>snowflake-id</artifactId>
                <version>${snowflake-id.version}</version>
            </dependency>
            <!-- Shared validation and utilities used by the applications and routing library. -->
            <dependency>
                <groupId>dev.nklip.javacraft</groupId>
                <artifactId>shardshop-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- ID generation and routing are separate core libraries for product/order only. -->
            <dependency>
                <groupId>dev.nklip.javacraft</groupId>
                <artifactId>shardshop-idgen</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.nklip.javacraft</groupId>
                <artifactId>shardshop-sharding</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.mockito</groupId>
                            <artifactId>mockito-core</artifactId>
                            <version>${mockito.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.junit.platform</groupId>
                            <artifactId>junit-platform-commons</artifactId>
                            <version>${junit6.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.junit.platform</groupId>
                            <artifactId>junit-platform-engine</artifactId>
                            <version>${junit6.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.junit.platform</groupId>
                            <artifactId>junit-platform-launcher</artifactId>
                            <version>${junit6.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <argLine>${test.jvm.args} ${mockito.agent.argLine} @{jacoco.it.argLine} @{argLine}</argLine>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <quarkus.devservices.enabled>false</quarkus.devservices.enabled>
                            <tc.image.postgresql>${tc.image.postgresql}</tc.image.postgresql>
                            <tc.image.rabbitmq>${tc.image.rabbitmq}</tc.image.rabbitmq>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                    <dependencies>
                        <!-- Replace the transitive Sisu milestone with GA; plexus-utils 3.6.2 fixes GHSA-6fmv-xxpf-w3cw. -->
                        <dependency>
                            <groupId>org.eclipse.sisu</groupId>
                            <artifactId>org.eclipse.sisu.plexus</artifactId>
                            <version>${sisu.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.eclipse.sisu</groupId>
                            <artifactId>org.eclipse.sisu.inject</artifactId>
                            <version>${sisu.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>3.6.2</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                    <!-- plexus-utils 4.1.0 fixes GHSA-6fmv-xxpf-w3cw. -->
                    <dependencies>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>4.1.0</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                    <!-- commons-beanutils 1.11.0 fixes GHSA-wxr5-93ph-8wr9. -->
                    <dependencies>
                        <dependency>
                            <groupId>commons-beanutils</groupId>
                            <artifactId>commons-beanutils</artifactId>
                            <version>1.11.0</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-help-plugin</artifactId>
                    <version>${maven-help-plugin.version}</version>
                    <!-- jsoup 1.23.2 fixes GHSA-pmhh-3w7g-xqp8. -->
                    <dependencies>
                        <dependency>
                            <groupId>org.jsoup</groupId>
                            <artifactId>jsoup</artifactId>
                            <version>1.23.2</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.apache.maven.enforcer</groupId>
                            <artifactId>enforcer-rules</artifactId>
                            <version>${maven-enforcer-plugin.version}</version>
                            <exclusions>
                                <!-- ShardShop does not use the evaluateBeanshell rule. -->
                                <exclusion>
                                    <groupId>org.apache-extras.beanshell</groupId>
                                    <artifactId>bsh</artifactId>
                                </exclusion>
                            </exclusions>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-toolchains-plugin</artifactId>
                    <version>${maven-toolchains-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <!-- plexus-utils 3.6.2 fixes GHSA-6fmv-xxpf-w3cw. -->
                    <dependencies>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>3.6.2</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>${cyclonedx-maven-plugin.version}</version>
                    <!-- Core 11.0.1 fixes GHSA-6fhj-vr9j-g45r; Jackson 2.22.x replaces the plugin's vulnerable 2.17.2. -->
                    <dependencies>
                        <dependency>
                            <groupId>org.cyclonedx</groupId>
                            <artifactId>cyclonedx-core-java</artifactId>
                            <version>11.0.1</version>
                        </dependency>
                        <dependency>
                            <groupId>com.fasterxml.jackson.core</groupId>
                            <artifactId>jackson-core</artifactId>
                            <version>2.22.3</version>
                        </dependency>
                        <dependency>
                            <groupId>com.fasterxml.jackson.core</groupId>
                            <artifactId>jackson-databind</artifactId>
                            <version>2.22.3</version>
                        </dependency>
                        <dependency>
                            <groupId>com.fasterxml.jackson.core</groupId>
                            <artifactId>jackson-annotations</artifactId>
                            <version>2.22</version>
                        </dependency>
                        <dependency>
                            <groupId>com.fasterxml.jackson.dataformat</groupId>
                            <artifactId>jackson-dataformat-xml</artifactId>
                            <version>2.22.3</version>
                        </dependency>
                        <dependency>
                            <groupId>com.fasterxml.jackson.dataformat</groupId>
                            <artifactId>jackson-dataformat-yaml</artifactId>
                            <version>2.22.3</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <!-- 1.5 avoids unsupported schema keywords in the pinned generator's validator. -->
                        <schemaVersion>1.5</schemaVersion>
                        <includeTestScope>true</includeTestScope>
                        <includeProvidedScope>true</includeProvidedScope>
                        <includeSystemScope>true</includeSystemScope>
                        <includeBomSerialNumber>false</includeBomSerialNumber>
                        <outputDirectory>${project.build.directory}/audit</outputDirectory>
                        <outputName>sbom</outputName>
                        <outputFormat>all</outputFormat>
                        <skipAttach>true</skipAttach>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>io.quarkus.platform</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                    <extensions>true</extensions>
                    <executions>
                        <execution>
                            <goals>
                                <goal>build</goal>
                                <goal>generate-code</goal>
                                <goal>generate-code-tests</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9.16,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>enforce-direct-id-generation-boundary</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${shardshop.idGenerationBoundary.skip}</skip>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>dev.nklip.javacraft:shardshop-idgen</exclude>
                                        <exclude>dev.nklip.javacraft:shardshop-sharding</exclude>
                                        <exclude>de.mkammerer.snowflake-id:snowflake-id</exclude>
                                    </excludes>
                                    <!-- Direct checking also includes optional dependencies. -->
                                    <searchTransitive>false</searchTransitive>
                                    <message>ID generation and service-only core dependencies are restricted to shardshop-idgen, shardshop-product and shardshop-order.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>enforce-transitive-id-generation-boundary</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${shardshop.idGenerationBoundary.skip}</skip>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>dev.nklip.javacraft:shardshop-idgen</exclude>
                                        <exclude>dev.nklip.javacraft:shardshop-sharding</exclude>
                                        <exclude>de.mkammerer.snowflake-id:snowflake-id</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                    <message>ID generation and service-only core dependencies are restricted to shardshop-idgen, shardshop-product and shardshop-order.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>${maven-toolchains-plugin.version}</version>
                <executions>
                    <execution>
                        <id>shardshop-java-toolchain</id>
                        <goals>
                            <goal>select-jdk-toolchain</goal>
                        </goals>
                        <configuration>
                            <version>[25,)</version>
                            <!-- Compile and test with the JAVA_HOME JDK, 25 or newer; no vendor or patch restriction. -->
                            <env>JAVA_HOME</env>
                            <useJdk>Never</useJdk>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <enablePreview>false</enablePreview>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Preserve inherited agents and Quarkus-generated JVM options. -->
                    <argLine>${test.jvm.args} ${mockito.agent.argLine} @{jacoco.argLine} @{argLine}</argLine>
                    <failIfNoTests>${shardshop.failIfNoTests}</failIfNoTests>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                    <!-- Do not pass the root reactor's unrelated image tags into ShardShop. -->
                    <systemPropertyVariables combine.self="override">
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <quarkus.devservices.enabled>false</quarkus.devservices.enabled>
                        <tc.image.postgresql>${tc.image.postgresql}</tc.image.postgresql>
                        <tc.image.rabbitmq>${tc.image.rabbitmq}</tc.image.rabbitmq>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <configuration>
                    <rulesUri>file://${shardshop.directory}/../../versions-rules.xml</rulesUri>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>integration-tests</id>
                                <configuration>
                                    <!-- Product/order run these infrastructure-free checks on every verify. -->
                                    <excludes>
                                        <exclude>**/ShardRoutingStartupIT.java</exclude>
                                    </excludes>
                                </configuration>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jacoco-it-agent</id>
                                <goals>
                                    <goal>prepare-agent-integration</goal>
                                </goals>
                                <configuration>
                                    <propertyName>jacoco.it.argLine</propertyName>
                                    <append>false</append>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jacoco-it-report</id>
                                <goals>
                                    <goal>report-integration</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>audit</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-help-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>effective-pom-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>effective-pom</goal>
                                </goals>
                                <configuration>
                                    <output>${project.build.directory}/audit/effective-pom.xml</output>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>dependency-tree-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>tree</goal>
                                </goals>
                                <configuration>
                                    <outputFile>${project.build.directory}/audit/dependencies.json</outputFile>
                                    <outputType>json</outputType>
                                </configuration>
                            </execution>
                            <execution>
                                <id>plugin-dependencies-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>resolve-plugins</goal>
                                </goals>
                                <configuration>
                                    <outputFile>${project.build.directory}/audit/plugins.txt</outputFile>
                                    <outputAbsoluteArtifactFilename>true</outputAbsoluteArtifactFilename>
                                    <!-- Exclude unused super-POM site/release defaults. -->
                                    <includeArtifactIds>maven-compiler-plugin,maven-surefire-plugin,maven-failsafe-plugin,maven-resources-plugin,maven-jar-plugin,maven-clean-plugin,maven-install-plugin,maven-deploy-plugin,maven-dependency-plugin,maven-help-plugin,maven-enforcer-plugin,maven-toolchains-plugin,jacoco-maven-plugin,cyclonedx-maven-plugin,quarkus-maven-plugin,versions-maven-plugin,exec-maven-plugin</includeArtifactIds>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>application-sbom</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>makeBom</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
