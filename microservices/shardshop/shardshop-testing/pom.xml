<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.nklip.javacraft</groupId>
        <artifactId>shardshop</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>shardshop-testing</artifactId>
    <packaging>jar</packaging>

    <properties>
        <shardshop.directory>${project.basedir}/..</shardshop.directory>
        <!-- The module has only tests: no JAR, and nothing to install or deploy. -->
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- The audit profile still writes the SBOM of the test classpath. -->
        <cyclonedx.skipNotDeployed>false</cyclonedx.skipNotDeployed>
        <!--
            Without main classes, target/classes does not exist, and the incremental test compilation warns
            "I/O error reading dependency state". The stale-source check is sufficient for test sources only.
        -->
        <maven.compiler.useIncrementalCompilation>false</maven.compiler.useIncrementalCompilation>
        <shardshop.generatorAllocation>${project.build.directory}/chart/shardshop/templates/generator-allocation.yaml</shardshop.generatorAllocation>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Cucumber's libraries declare version ranges for each other; the BOM fixes their exact versions. -->
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.rabbitmq</groupId>
            <artifactId>amqp-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Shares the state of one scenario between step classes, as cucumber-spring does in Spring modules. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- The lab's Flyway image removes this plugin too; the catalog stream needs only PostgreSQL. -->
                <exclusion>
                    <groupId>org.flywaydb</groupId>
                    <artifactId>flyway-database-cockroachdb</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Parse rendered chart documents with the already-qualified platform version. -->
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Contracts.feature and the product response checks use the contract test helper of common. -->
        <dependency>
            <groupId>dev.nklip.javacraft</groupId>
            <artifactId>shardshop-common</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-openapi</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Cucumber 8 writes its HTML and JSON reports with Jackson 2 only when this module is present. -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Failsafe selects the JBoss Log Manager, as in the application modules; Testcontainers logs through SLF4J. -->
        <dependency>
            <groupId>org.jboss.logmanager</groupId>
            <artifactId>jboss-logmanager</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.slf4j</groupId>
            <artifactId>slf4j-jboss-logmanager</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <skipIfEmpty>true</skipIfEmpty>
                </configuration>
            </plugin>
            <plugin>
                <!-- Docker scenarios use -Pintegration; live lab gates use the separate opt-in -Pkind profile. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                    <excludes>
                        <exclude>**/KindIT.java</exclude>
                    </excludes>
                    <systemPropertyVariables>
                        <!-- The scenarios find the packages, migrations and datasets in this source tree. -->
                        <shardshop.directory>${shardshop.directory}</shardshop.directory>
                        <!-- Logs, routing files and certificates of the scenarios; mvn clean removes them. -->
                        <shardshop.testing.work>${project.build.directory}/scenario-runs</shardshop.testing.work>
                        <!-- The generator RBAC and retention policy that the integration profile renders. -->
                        <shardshop.testing.generator-allocation>${shardshop.generatorAllocation}</shardshop.testing.generator-allocation>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>application-test-artifacts</id>
            <!-- Infrastructure observers need no packaged applications or installed application POMs. -->
            <activation>
                <property>
                    <name>!shardshop.infrastructureOnly</name>
                </property>
            </activation>
            <dependencies>
                <!--
                    The scenarios start the packaged quarkus-app folders of these applications. A POM dependency
                    without transitive dependencies only makes the reactor package them first; no application
                    class enters this classpath.
                -->
                <dependency>
                    <groupId>dev.nklip.javacraft</groupId>
                    <artifactId>shardshop-product</artifactId>
                    <version>${project.version}</version>
                    <type>pom</type>
                    <scope>test</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>dev.nklip.javacraft</groupId>
                    <artifactId>shardshop-order</artifactId>
                    <version>${project.version}</version>
                    <type>pom</type>
                    <scope>test</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>dev.nklip.javacraft</groupId>
                    <artifactId>shardshop-ledger</artifactId>
                    <version>${project.version}</version>
                    <type>pom</type>
                    <scope>test</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>dev.nklip.javacraft</groupId>
                    <artifactId>shardshop-product-seeder</artifactId>
                    <version>${project.version}</version>
                    <type>pom</type>
                    <scope>test</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>dev.nklip.javacraft</groupId>
                    <artifactId>shardshop-product-reader</artifactId>
                    <version>${project.version}</version>
                    <type>pom</type>
                    <scope>test</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>kind</id>
            <properties>
                <shardshop.kind.tags>kind-deployment</shardshop.kind.tags>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes combine.self="override">
                                <include>**/KindIT.java</include>
                            </includes>
                            <excludes combine.self="override"/>
                            <!-- JUnit discovery filters reject an empty selection; Cucumber filters merely skip it. -->
                            <groups>${shardshop.kind.tags}</groups>
                        </configuration>
                        <executions>
                            <execution>
                                <id>kind-tests</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>integration-tests</id>
                                <configuration>
                                    <excludes combine.self="override">
                                        <exclude>**/ShardRoutingStartupIT.java</exclude>
                                        <exclude>**/KindIT.java</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!--
                            The generator scenarios apply the real RBAC and retention policy of the chart. helm comes
                            from PATH, using the same environment values and inventory as cluster-create.sh. Helm 4.3 ignores
                            show-only with output-dir, thus it writes all infrastructure templates; the scenarios read
                            only generator-allocation.yaml. Its "wrote" lines go to the debug log, and errors stay visible.
                        -->
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>render-generator-allocation</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>helm</executable>
                                    <arguments>
                                        <argument>template</argument>
                                        <argument>shardshop</argument>
                                        <argument>${shardshop.directory}/infra/helm/shardshop</argument>
                                        <argument>--namespace</argument>
                                        <argument>shardshop</argument>
                                        <argument>--values</argument>
                                        <argument>${shardshop.directory}/infra/helm/shardshop/kind-values.yaml</argument>
                                        <argument>--values</argument>
                                        <argument>${shardshop.directory}/infra/shards.yaml</argument>
                                        <argument>--set-string</argument>
                                        <argument>render=infrastructure</argument>
                                        <argument>--output-dir</argument>
                                        <argument>${project.build.directory}/chart</argument>
                                    </arguments>
                                    <useMavenLogger>true</useMavenLogger>
                                    <quietLogs>true</quietLogs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
