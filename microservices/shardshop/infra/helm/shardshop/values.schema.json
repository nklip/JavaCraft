{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["render", "migrationShard", "shards"],
  "properties": {
    "render": {
      "type": "string",
      "enum": ["infrastructure", "migration", "routing", "inventory", "namespace"]
    },
    "migrationShard": {"type": "string"},
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 45,
            "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$",
            "not": {"enum": ["ledger-db"]}
          }
        }
      }
    }
  }
}
