{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "image": {
      "type": "string",
      "pattern": "^$|^docker\\.io/library/shardshop-[a-z-]+@sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "render",
    "migrationShard",
    "migrationStream",
    "shards"
  ],
  "properties": {
    "restartToken": {
      "type": "string",
      "pattern": "^$|^restart-[0-9a-f]{24}$"
    },
    "render": {
      "type": "string",
      "enum": [
        "infrastructure",
        "migration",
        "routing",
        "inventory",
        "namespace",
        "applications",
        "seeding",
        "kind-configuration",
        "dns-probes",
        "generator-identity",
        "migration-topology",
        "migrations",
        "application-release"
      ]
    },
    "migrationShard": {
      "type": "string"
    },
    "migrationStream": {
      "type": "string",
      "enum": [
        "catalog",
        "ordering",
        "ledger"
      ]
    },
    "run": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {
          "$ref": "#/definitions/image"
        },
        "product-seeder": {
          "$ref": "#/definitions/image"
        },
        "product-reader": {
          "$ref": "#/definitions/image"
        },
        "order": {
          "$ref": "#/definitions/image"
        },
        "ledger": {
          "$ref": "#/definitions/image"
        },
        "order-producer": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "region"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "US",
              "EU",
              "ASIA"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 44,
            "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$",
            "not": {
              "enum": [
                "ledger-db"
              ]
            }
          }
        }
      }
    },
    "datasetVersion": {
      "type": "string",
      "enum": [
        "catalog-v1"
      ]
    },
    "productSeeder": {
      "type": "object",
      "properties": {
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "SHARDSHOP_SEEDER_MAX_ATTEMPTS": {
              "type": "string",
              "pattern": "^[+]?[0-9]+$"
            },
            "SHARDSHOP_SEEDER_CONNECT_TIMEOUT": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_SEEDER_REQUEST_TIMEOUT": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_SEEDER_RETRY_BACKOFF": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_SEEDER_MAX_RETRY_BACKOFF": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            }
          }
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 86400
        }
      }
    },
    "productReader": {
      "type": "object",
      "properties": {
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "SHARDSHOP_READER_REQUEST_RATE": {
              "type": "string",
              "pattern": "^[+]?[0-9]+$"
            },
            "SHARDSHOP_READER_WORKERS": {
              "type": "string",
              "pattern": "^[+]?[0-9]+$"
            },
            "SHARDSHOP_READER_CONNECTIONS": {
              "type": "string",
              "pattern": "^[+]?[0-9]+$"
            },
            "SHARDSHOP_READER_MAX_ATTEMPTS": {
              "type": "string",
              "pattern": "^[+]?[0-9]+$"
            },
            "SHARDSHOP_READER_CONNECT_TIMEOUT": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_READER_REQUEST_DEADLINE": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_READER_RETRY_INTERVAL": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_READER_MAX_CONNECTION_LIFETIME": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_READER_IDLE_TIMEOUT": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_READER_REPORT_INTERVAL": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            }
          }
        }
      }
    },
    "product": {
      "type": "object",
      "properties": {
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shardshop.catalog.read-profile": {
              "type": "string",
              "enum": [
                "primary",
                "replica"
              ]
            },
            "shardshop.catalog.max-pool-size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "shardshop.catalog.max-id-candidates": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^docker\\.io/library/shardshop-flyway(:[a-zA-Z0-9_.-]+)?@sha256:[0-9a-f]{64}$"
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 86400
        }
      }
    },
    "rabbitmq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "replicas",
        "runAsUser",
        "fsGroup",
        "storage",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^docker\\.io/library/rabbitmq(:4\\.[3-9][0-9]*\\.[0-9]+-management)?@sha256:[0-9a-f]{64}$"
        },
        "replicas": {
          "type": "integer",
          "const": 1
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
            },
            "storageClass": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            }
          }
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "order": {
      "type": "object",
      "properties": {
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shardshop.order.max-pool-size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "shardshop.order.max-id-candidates": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "shardshop.order.catalog-concurrency": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "shardshop.order.catalog-deadline": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            }
          }
        }
      }
    },
    "ledgerApplication": {
      "type": "object",
      "properties": {
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shardshop.ledger.allowed-currencies": {
              "type": "string",
              "allOf": [
                {
                  "pattern": "^[A-Z]{3}(,[A-Z]{3})*$"
                },
                {
                  "pattern": "(^|,)USD(,|$)"
                },
                {
                  "not": {
                    "pattern": "(^|,)EUR(,|$)"
                  }
                }
              ]
            },
            "shardshop.ledger.max-pool-size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "shardshop.ledger.publisher.batch-size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "shardshop.ledger.publisher.poll-interval": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            }
          }
        }
      }
    },
    "orderProducer": {
      "type": "object",
      "properties": {
        "runName": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^$|^[^\\s$](?:[^\\r\\n$]*[^\\s$])?$"
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "SHARDSHOP_PRODUCER_REJECTED_ORDER_PERCENT": {
              "type": "string",
              "pattern": "^(100|[0-9]{1,2})$"
            },
            "SHARDSHOP_PRODUCER_MAX_ATTEMPTS": {
              "type": "string",
              "pattern": "^([1-9]|10)$"
            },
            "SHARDSHOP_PRODUCER_CONNECT_TIMEOUT": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_PRODUCER_REQUEST_TIMEOUT": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_PRODUCER_ORDER_INTERVAL": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_PRODUCER_POLL_INTERVAL": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_PRODUCER_ORDER_DEADLINE": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_PRODUCER_STARTUP_DEADLINE": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_PRODUCER_RETRY_BACKOFF": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            },
            "SHARDSHOP_PRODUCER_MAX_RETRY_BACKOFF": {
              "type": "string",
              "pattern": "^[+]?[0-9]+([.][0-9]+)?(ms|[smhd])?$|^P[0-9T.DHMS]+$"
            }
          }
        }
      }
    }
  }
}
