{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "image": {"type": "string", "pattern": "^$|^docker\\.io/library/shardshop-[a-z-]+@sha256:[0-9a-f]{64}$"}
  },
  "required": ["render", "migrationShard", "migrationStream", "shards"],
  "properties": {
    "render": {
      "type": "string",
      "enum": ["infrastructure", "migration", "routing", "inventory", "namespace", "applications", "seeding"]
    },
    "migrationShard": {"type": "string"},
    "migrationStream": {"type": "string", "enum": ["catalog", "ordering", "ledger"]},
    "run": {"type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"},
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {"$ref": "#/definitions/image"},
        "product-seeder": {"$ref": "#/definitions/image"},
        "product-reader": {"$ref": "#/definitions/image"}
      }
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "region"],
        "properties": {
          "region": {"type": "string", "enum": ["US", "EU", "ASIA"]},
          "name": {
            "type": "string",
            "maxLength": 44,
            "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$",
            "not": {"enum": ["ledger-db"]}
          }
        }
      }
    }
  }
}
