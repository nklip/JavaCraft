# The kubeconfig of the gates in the cluster: the API server of the cluster and the token of
# the shardshop-gates ServiceAccount. The kind Maven profile requires the context
# kind-<cluster>, and the gates image sets the cluster shardshop-test-eks.
apiVersion: v1
kind: Config
clusters:
  - name: in-cluster
    cluster:
      server: https://kubernetes.default.svc
      certificate-authority: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
users:
  - name: shardshop-gates
    user:
      tokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
contexts:
  - name: kind-shardshop-test-eks
    context:
      cluster: in-cluster
      user: shardshop-gates
      namespace: shardshop
current-context: kind-shardshop-test-eks
