<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.nklip.javacraft</groupId>
    <artifactId>javacraft</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <!-- project -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.release>25</java.release>

        <!-- maven plugins -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
        <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <!-- org.codehaus.mojo plugins -->
        <build-helper-maven-plugin.version>3.6.1</build-helper-maven-plugin.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
        <jaxb2-maven-plugin.version>4.1.0</jaxb2-maven-plugin.version>
        <versions-maven-plugin.version>2.21.0</versions-maven-plugin.version>
        <!-- 3rd party plugins -->
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <jaxws-maven-plugin.version>4.0.5</jaxws-maven-plugin.version>
        <frontend-maven-plugin.version>2.0.1</frontend-maven-plugin.version>

        <!--
            Spring Boot 4.x. The spring-boot-dependencies BOM below manages the Spring
            Framework, Spring Kafka, Jackson, Artemis, PostgreSQL, H2, Liquibase, slf4j,
            Mockito and Testcontainers version lines, so those are deliberately NOT pinned
            here. Add a property back only when we intend to deviate from the BOM.
        -->
        <spring-boot.version>4.1.0</spring-boot.version>
        <!-- springdoc is not Boot-managed; the 3.x line is the one built against Boot 4 -->
        <springdoc-openapi-starter-webmvc-ui.version>3.0.3</springdoc-openapi-starter-webmvc-ui.version>

        <!-- jakarta / xml -->
        <jakarta.jws-api.version>3.0.0</jakarta.jws-api.version>
        <jakarta.xml.bind-api.version>4.0.5</jakarta.xml.bind-api.version>
        <jakarta.xml.ws-api.version>4.0.3</jakarta.xml.ws-api.version>
        <jaxb-runtime.version>4.0.9</jaxb-runtime.version>

        <!-- serialization / networking -->
        <!-- ahead of the Boot BOM on purpose: vfs and echo/netty use the 4.2-only
             MultiThreadIoEventLoopGroup / NioIoHandler APIs -->
        <netty.version>4.2.16.Final</netty.version>
        <!-- protoc-jar-maven-plugin needs a literal protoc version, so this stays pinned;
             keep it aligned with the protobuf-java version the Boot BOM manages -->
        <protobuf.version>4.34.2</protobuf.version>

        <!-- utilities -->
        <commons-compress.version>1.28.0</commons-compress.version>
        <guava.version>33.6.0-jre</guava.version>
        <lombok.version>1.18.46</lombok.version>
        <opencsv.version>5.12.0</opencsv.version>
        <codemirror.version>5.65.20</codemirror.version>
        <mongo-java-server.version>1.47.0</mongo-java-server.version>

        <!-- testing -->
        <!-- JUnit 6 unifies Jupiter and Platform on one version line, so there is no
             separate junit-platform-suite version any more -->
        <junit6.version>6.1.2</junit6.version>
        <!--
            Pinned on purpose even though the Boot BOM manages Mockito: the shared Surefire
            configuration builds a -javaagent path out of this exact value, so the property
            and the agent jar must never drift apart.
        -->
        <mockito.version>5.23.0</mockito.version>
        <cucumber.version>7.34.6</cucumber.version>
        <rest-assured.version>6.0.1</rest-assured.version>
        <wiremock.version>3.13.2</wiremock.version>
        <maven-model.version>3.9.16</maven-model.version>

        <!-- testcontainers docker images -->
        <tc.image.artemis>apache/artemis:2.53.0-alpine</tc.image.artemis>
        <!--
            Must track the elasticsearch-java client version the Spring Boot BOM manages
            (9.4.x). The 9.x client sends 'compatible-with=9' media types that an 8.x
            server rejects with media_type_header_exception, so these cannot drift apart.
        -->
        <tc.image.elasticsearch>docker.elastic.co/elasticsearch/elasticsearch:9.4.2</tc.image.elasticsearch>
        <tc.image.kafka>apache/kafka:3.9.0</tc.image.kafka>
        <tc.image.postgresql>postgres:17</tc.image.postgresql>

        <!--
            If test.jvm.args is undefined, some runs pass a raw placeholder
            to the forked JVM and tests fail to start.

            Mockito's inline mock maker appends its dispatcher to the bootstrap classpath,
            which disables class-data sharing. Disable it explicitly to avoid the JVM warning.
        -->
        <test.jvm.args>-Xshare:off</test.jvm.args>
        <mockito.agent.argLine>
            -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
        </mockito.agent.argLine>

        <!--
            JaCoCo's prepare-agent writes the agent's -javaagent flag into this property.

            It deliberately does NOT use JaCoCo's default property name (argLine): Surefire's
            <argLine> is configured explicitly below, and an explicit <argLine> wins over the
            argLine *property*, so the default wiring would silently produce empty coverage
            data. Naming the property here and referencing it from Surefire's <argLine>
            keeps the Mockito agent and the JaCoCo agent on the same command line.

            The empty default matters for the same reason test.jvm.args has one: with
            -Djacoco.skip=true prepare-agent never runs, and without a default the raw
            placeholder would reach the forked JVM and every test would fail to start.

            Because of that default, Surefire must reference this as @{jacoco.argLine} rather
            than ${jacoco.argLine} — see the comment on Surefire's <argLine> below.
        -->
        <jacoco.argLine/>

        <!--
            The -DallowMajorUpdates=true flag on the command line does not override
            the explicit <allowMajorUpdates>false</allowMajorUpdates>
            in the plugin's <configuration> block in pom.xml.

            Maven plugin configuration values take precedence over -D system properties.

            That's the reason why I created this property.
        -->
        <allowMajorUpdates>false</allowMajorUpdates>
    </properties>

    <modules>
        <module>algs</module>
        <module>blueprints</module>
        <module>echo</module>
        <module>mathparser</module>
        <module>microservices</module>
        <module>tic-tac-toe</module>
        <module>vfs</module>
        <module>xlspaceship</module>
    </modules>

    <developers>
        <developer>
            <name>Lipatov Nikita</name>
            <timezone>+4</timezone>
        </developer>
    </developers>

    <!--
        A BOM (Bill Of Materials) is a pom-only dependency that does not put code on any classpath by itself.
        Instead, it provides a catalog of recommended versions for a family of artifacts.

        Maven applies BOM entries only during dependency resolution. This means:
        1. Child modules can declare artifacts without repeating <version>.
        2. Transitive dependencies can be aligned to one coherent version line.
        3. The actual selected version is decided by dependency mediation + dependencyManagement imports.

        Why we use BOMs here:
        - JUnit BOM keeps Jupiter + Platform artifacts on the same release train.
        - Netty BOM keeps all Netty modules on one version line.
        - Spring Boot BOM manages the large Spring ecosystem and many common libraries.

        Why import order matters:
        Maven uses the "nearest definition wins" rule, and inside the same dependencyManagement section
        the first matching managed version wins.

        That is the reason the more specific BOMs are imported before the broader Spring Boot BOM:
        - JUnit BOM comes first so Boot does not silently force an older JUnit/JUnit Platform line
          (Boot 4.1.0 manages Jupiter 6.0.3; we want 6.1.2).
        - Netty BOM comes next so all Netty modules stay on the single version we chose
          (Boot 4.1.0 manages 4.2.15.Final; we want 4.2.16.Final).
        - Spring Boot BOM comes after that and manages the rest of the Spring-aligned dependency graph.

        In practice, this block means:
        - modules usually should not hardcode versions for JUnit, Netty, or Spring Boot managed libraries
        - if a transitive dependency unexpectedly downgrades, the BOM import order here is one of the first places to inspect
        - adding another broad BOM later should be done carefully, because it can override or conflict with the version
          alignment established here
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit6.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${java.release}</release>
                    <showWarnings>true</showWarnings>
                    <encoding>UTF-8</encoding>
                    <showDeprecation>true</showDeprecation>
                    <maxmem>512m</maxmem>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <!-- Load Mockito as a startup agent so it never needs dynamic self-attachment. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <dependencies>
                    <!-- Ensures the agent path exists before any child module starts its test JVM. -->
                    <dependency>
                        <groupId>org.mockito</groupId>
                        <artifactId>mockito-core</artifactId>
                        <version>${mockito.version}</version>
                    </dependency>
                    <!--
                        Surefire brings an older JUnit Platform line on the plugin classpath.
                        Override it here so Jupiter, Platform, and Cucumber stay aligned for all modules.
                        Since JUnit 6 the Platform shares the Jupiter version line, so these track
                        ${junit5.version} directly.
                    -->
                    <dependency>
                        <groupId>org.junit.platform</groupId>
                        <artifactId>junit-platform-commons</artifactId>
                        <version>${junit6.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.junit.platform</groupId>
                        <artifactId>junit-platform-engine</artifactId>
                        <version>${junit6.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.junit.platform</groupId>
                        <artifactId>junit-platform-launcher</artifactId>
                        <version>${junit6.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!--
                        @{jacoco.argLine} is Surefire's late-replacement syntax, not a typo for ${...}.
                        Maven interpolates ${...} while building the model, which is before
                        jacoco:prepare-agent runs, so ${jacoco.argLine} would freeze to the empty
                        default in <properties> and the agent would never attach. @{...} is resolved by
                        Surefire itself, at execution time, against the property prepare-agent set.
                    -->
                    <argLine>${test.jvm.args} ${mockito.agent.argLine} @{jacoco.argLine}</argLine>
                    <systemPropertyVariables>
                        <tc.image.elasticsearch>${tc.image.elasticsearch}</tc.image.elasticsearch>
                        <tc.image.artemis>${tc.image.artemis}</tc.image.artemis>
                        <tc.image.kafka>${tc.image.kafka}</tc.image.kafka>
                        <tc.image.postgresql>${tc.image.postgresql}</tc.image.postgresql>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <!--
                    Fails the build early and with a readable message when the local toolchain
                    cannot produce the artifacts this reactor describes, instead of surfacing it
                    as an obscure compiler or plugin error deep into a 70+ module build.

                    Deliberately NOT enabled yet: dependencyConvergence and requireUpperBoundDeps.
                    Both currently fail against the Spring Boot dependency graph, so turning them
                    on belongs in its own change where the conflicts can be resolved properly.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                </requireMavenVersion>
                                <!-- Compiling with <release>25</release> needs a JDK that knows release 25. -->
                                <requireJavaVersion>
                                    <version>[${java.release},)</version>
                                </requireJavaVersion>
                                <!-- Catches a dependency declared twice in one pom, where the second silently wins. -->
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                    Coverage measurement only: report, no <check> thresholds. CLAUDE.md asks for
                    100% coverage of new lines, but a gate applied across every existing module at
                    once would just fail the build everywhere, so the numbers come first.

                    Per-module HTML/XML reports land in target/site/jacoco after `mvn test`.
                -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- See the jacoco.argLine property comment above for why this is renamed. -->
                            <propertyName>jacoco.argLine</propertyName>
                            <!--
                                JaCoCo 0.8.15 appends to an existing jacoco.exec by default.
                                Replacing it makes each plain `mvn test` report only that invocation
                                instead of accumulating stale coverage from earlier runs.

                                This assumes a single forked test JVM per module. A future module
                                using multiple forks must override this or use separate destination
                                files so one fork does not overwrite another fork's coverage.
                            -->
                            <append>false</append>
                        </configuration>
                    </execution>
                    <execution>
                        <!--
                            Bound to `test` rather than the plugin's default `verify` so the report
                            is produced by the per-module `mvn test` loop CLAUDE.md prescribes.
                        -->
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${versions-maven-plugin.version}</version>
                <configuration>
                    <allowMajorUpdates>${allowMajorUpdates}</allowMajorUpdates>
                    <allowSnapshots>false</allowSnapshots>
                    <rulesUri>file://${maven.multiModuleProjectDirectory}/versions-rules.xml</rulesUri>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>docker-check</id>
            <activation>
                <!-- active by default; deactivated when -DskipTests is set -->
                <property>
                    <name>!skipTests</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>check-docker</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>docker</executable>
                                    <arguments>
                                        <argument>info</argument>
                                        <argument>--format</argument>
                                        <argument>Docker {{.ServerVersion}} is running</argument>
                                    </arguments>
                                    <successCodes>
                                        <successCode>0</successCode>
                                    </successCodes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
